{
  "buildCommand": "bash build.sh",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/transcript.py": {
      "maxDuration": 10,
      "excludeFiles": "{*.html,*.png,*.jpg,*.jpeg,*.pdf,*.svg,cutouts/**,fonts/**,api/_tools/**,api/*.js,dist/**,node_modules/**,.vercel_python_packages/**,claude-chief-of-staff/**}"
    },
    "api/thumbnail.py": {
      "maxDuration": 10,
      "includeFiles": "{cutouts,fonts}/**",
      "excludeFiles": "{*.html,*.pdf,*.svg,api/_tools/**,api/*.js,dist/**,node_modules/**,.vercel_python_packages/**,claude-chief-of-staff/**}"
    },
    "api/generate.py": {
      "maxDuration": 10,
      "excludeFiles": "{*.html,*.png,*.jpg,*.jpeg,*.pdf,*.svg,cutouts/**,fonts/**,api/_tools/**,api/*.js,dist/**,node_modules/**,.vercel_python_packages/**,claude-chief-of-staff/**}"
    },
    "api/gtm-data.js": {
      "includeFiles": "data/**"
    },
    "api/strategy-chat.js": {
      "maxDuration": 300,
      "includeFiles": "data/**"
    },
    "api/youtube-generate.js": {
      "maxDuration": 120
    },
    "api/burn-upload.js": {
      "maxDuration": 10
    },
    "api/fathom-ingest.js": {
      "maxDuration": 300
    },
    "api/fathom-list.js": {
      "maxDuration": 60
    },
    "api/fathom-cache.js": {
      "maxDuration": 60
    },
    "api/notion-publish.js": {
      "maxDuration": 60
    },
    "api/strategy-state.js": {
      "maxDuration": 30
    },
    "api/kb-upload.js": {
      "maxDuration": 30
    },
    "api/kb-manage.js": {
      "maxDuration": 30
    },
    "api/supadata.js": {
      "maxDuration": 15
    },
    "api/investor-access.js": {
      "maxDuration": 10
    },
    "api/vc-meetings.js": {
      "maxDuration": 30
    },
    "api/vc-fit.js": {
      "maxDuration": 60
    },
    "api/vc-state.js": {
      "maxDuration": 30
    },
    "api/investor-leads.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
